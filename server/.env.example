# Пример настроек сервера.
# Скопируйте этот файл в server/.env и подставьте свои значения:
#   cp server/.env.example server/.env
# Настоящий server/.env в репозиторий не попадает — в нём пароли.

# Где лежит база данных.
# При разработке на своём компьютере — файл SQLite рядом со схемой, ставить ничего не нужно.
DATABASE_URL="file:./dev.db"

# На сервере база — PostgreSQL. Строка выглядит так (раскомментируйте и замените значения):
#   пользователь : пароль @ хост : порт / имя_базы
# Хост "postgres" — это имя сервиса из docker-compose.yml, менять его не нужно.
# Пароль берите из букв и цифр: символы вроде @ / : ломают строку подключения.
# DATABASE_URL="postgresql://pdreg:ЗАМЕНИТЕ_ПАРОЛЬ@postgres:5432/pdreg?schema=public"
#
# Не забудьте: при переходе на PostgreSQL в server/prisma/schema.prisma провайдер
# должен быть "postgresql", а не "sqlite". Подробности — в docs/DEPLOY.md.

# Порт, на котором слушает API. Веб-интерфейс при разработке сам ходит на него через прокси.
PORT=3001

# Режим работы: development на своём компьютере, production на сервере.
# В режиме production cookie сессии отдаётся только по HTTPS — без сертификата вход не сработает.
NODE_ENV=development

# Сколько часов живёт сессия после входа. По истечении нужно войти заново.
SESSION_TTL_HOURS=12

# Папка для загруженных файлов: сканов направлений, заключений, снимков УЗИ.
# На сервере это отдельный том Docker, путь абсолютный: /app/uploads
UPLOAD_DIR="./uploads"
